--- !u!114 &1423538695
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1423538693}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd5dec8f4b5a9964c8d6d00841a9ee6e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  frames:
  - duration: 5
    sprite: {fileID: 21300000, guid: 3f47179607fa2a249b91f6a0fde00cf4, type: 3}
    text: '"There is a dangerous defective clone on the loose" - said the broadcaster.
      He was talking about me.'
    clip: {fileID: 0}
  - duration: 5
    sprite: {fileID: 21300000, guid: 1ce4c18a9e327354ea60848d01443662, type: 3}
    text: To find me a klonoskopia procedure was ordered for all clones. It check
      wether the clone thinks the same as the human base.
    clip: {fileID: 0}
  - duration: 5
    sprite: {fileID: 21300000, guid: 6012536532b25244dbf9bcf1a91a3d3b, type: 3}
    text: The human and the clone independently enter patterns. If clone comes up
      with different answers then he doesn't think like his human base. I need to
      be careful to not get caught.
    clip: {fileID: 0}
  image: {fileID: 1973232051}
  text: {fileID: 855035408}
  audioSource: {fileID: 1561673844}
